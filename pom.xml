<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.vecluu</groupId>
    <artifactId>jdoc</artifactId>
    <version>${revision}</version>
    <name>jdoc</name>
    <description>Java library docs CLI for agents</description>
    <url>https://github.com/vecluu/jdoc</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>vecluu</id>
            <name>vecluu</name>
            <url>https://github.com/vecluu</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/vecluu/jdoc.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/vecluu/jdoc.git</developerConnection>
        <url>https://github.com/vecluu/jdoc</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <revision>0.0.0-SNAPSHOT</revision>
        <!-- Reproducible jar: every entry gets this timestamp. A fixed default for development builds; when
             SOURCE_DATE_EPOCH is set (CI sets it to the commit time, scripts/assemble.sh uses the same value for the
             tarball), the profile "source-date-epoch" below uses it instead, so one commit builds one jar. -->
        <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Override with -Djdoc.buildDir=... so parallel builds do not share target/ -->
        <jdoc.buildDir>${project.basedir}/target</jdoc.buildDir>
        <main.class>io.github.vecluu.jdoc.Main</main.class>

        <!-- runtime -->
        <sqlite-jdbc.version>3.54.1.0</sqlite-jdbc.version>
        <jsoup.version>1.23.2</jsoup.version>
        <asm.version>9.11.1</asm.version>
        <vineflower.version>1.12.0</vineflower.version>
        <slf4j.version>2.0.17</slf4j.version>
        <lombok.version>1.18.48</lombok.version>

        <!-- test -->
        <junit.version>6.1.3</junit.version>
        <assertj.version>3.27.7</assertj.version>

        <!-- plugins -->
        <compiler-plugin.version>3.14.1</compiler-plugin.version>
        <resources-plugin.version>3.4.0</resources-plugin.version>
        <surefire.version>3.6.1</surefire.version>
        <shade-plugin.version>3.6.2</shade-plugin.version>
        <jar-plugin.version>3.4.2</jar-plugin.version>
        <dependency-plugin.version>3.11.0</dependency-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite-jdbc.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>${jsoup.version}</version>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
            <version>${asm.version}</version>
        </dependency>
        <dependency>
            <groupId>org.vineflower</groupId>
            <artifactId>vineflower</artifactId>
            <version>${vineflower.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <!-- slf4j-simple logs to stderr, keeping stdout clean for command output -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <directory>${jdoc.buildDir}</directory>
        <finalName>jdoc</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler-plugin.version}</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <parameters>true</parameters>
                    <compilerArgs>
                        <arg>-Xlint:all,-processing,-serial</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <!-- pinned (not Maven's default) because RealMavenResolutionIT's offline project pins the same version -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>${resources-plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                    <!-- run ITs against classes, not the shaded jar -->
                    <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                    <systemPropertyVariables>
                        <!-- LicenseNoticesIT inspects the shaded jar and the resolved runtime dependencies -->
                        <jdoc.projectRoot>${project.basedir}</jdoc.projectRoot>
                        <jdoc.shadedJar>${project.build.directory}/${project.build.finalName}.jar</jdoc.shadedJar>
                        <jdoc.runtimeDependencies>${project.build.directory}/runtime-dependencies.txt</jdoc.runtimeDependencies>
                        <!-- RealMavenResolutionIT: the Maven running this build (also under ./mvnw, no PATH needed),
                             its local repository (read-only tail of the offline run) and the plugins this build has
                             resolved there, which the IT's offline project pins -->
                        <jdoc.itFixtureJars>${project.build.directory}/it-fixture-jars</jdoc.itFixtureJars>
                        <jdoc.mavenHome>${maven.home}</jdoc.mavenHome>
                        <jdoc.localRepository>${settings.localRepository}</jdoc.localRepository>
                        <jdoc.offlinePlugins>maven-compiler-plugin:${compiler-plugin.version},maven-resources-plugin:${resources-plugin.version},maven-dependency-plugin:${dependency-plugin.version}</jdoc.offlinePlugins>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${jar-plugin.version}</version>
                <configuration>
                    <!-- an up-to-date jdoc.jar is the shaded one; re-shading it duplicates the META-INF notices -->
                    <forceCreation>true</forceCreation>
                </configuration>
            </plugin>
            <plugin>
                <!-- writes the resolved runtime dependencies for LicenseNoticesIT -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>${dependency-plugin.version}</version>
                <executions>
                    <execution>
                        <id>runtime-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>list</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputFile>${project.build.directory}/runtime-dependencies.txt</outputFile>
                            <sort>true</sort>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- real JDK-8-built jars for Jdk8JavadocParameterNamesIT, resolved by the build so the IT
                             never depends on what happens to be in ~/.m2 -->
                        <id>it-fixture-jars</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.apache.commons</groupId>
                                    <artifactId>commons-lang3</artifactId>
                                    <version>3.5</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.apache.commons</groupId>
                                    <artifactId>commons-lang3</artifactId>
                                    <version>3.5</version>
                                    <classifier>javadoc</classifier>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${project.build.directory}/it-fixture-jars</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${shade-plugin.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <!-- jdoc's own NOTICE is added below; a dependency NOTICE must be merged by hand -->
                                        <exclude>META-INF/NOTICE</exclude>
                                        <exclude>META-INF/NOTICE.*</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <!-- drops dependency META-INF/LICENSE{,.txt,.md}; their texts live in THIRD-PARTY-NOTICES -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                                    <resource>META-INF/LICENSE</resource>
                                    <file>${project.basedir}/LICENSE</file>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                                    <resource>META-INF/NOTICE</resource>
                                    <file>${project.basedir}/NOTICE</file>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                                    <resource>META-INF/THIRD-PARTY-NOTICES</resource>
                                    <file>${project.basedir}/THIRD-PARTY-NOTICES</file>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                    <manifestEntries>
                                        <Multi-Release>true</Multi-Release>
                                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- SOURCE_DATE_EPOCH (seconds since the epoch) sets the jar entry timestamps -->
            <id>source-date-epoch</id>
            <activation>
                <property>
                    <name>env.SOURCE_DATE_EPOCH</name>
                </property>
            </activation>
            <properties>
                <project.build.outputTimestamp>${env.SOURCE_DATE_EPOCH}</project.build.outputTimestamp>
            </properties>
        </profile>
    </profiles>
</project>
